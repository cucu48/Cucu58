/*
 * Cucu58 keymap: what every key does. This is the file you edit most.
 *
 * Each layer lists the 58 keys in the same order as the matrix transform in
 * boards/shields/cucu58/cucu58.dtsi:
 *   4 rows of 12 (left outer -> inner, then right inner -> outer), then the 10 thumb keys
 *   (left: super inny middy reachy extra | right: extra reachy middy inny super).
 * thumb_extra is the key right of the inner column, between the home and bottom rows.
 *
 * Common behaviors:
 *   &kp X       press key X (names: https://zmk.dev/docs/keymaps/list-of-keycodes)
 *   &mo N       layer N while held
 *   &trans      fall through to the layer below
 *   &none       do nothing
 *   &bt ...     Bluetooth profiles; &out ... USB/Bluetooth output
 *   &bootloader enter flashing mode; &sys_reset restart (on the half that is pressed)
 * More: https://zmk.dev/docs/keymaps/behaviors
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE   0
#define LOWER  1
#define RAISE  2
#define ADJUST 3

/ {
    // Hold LOWER and RAISE together to get the ADJUST layer.
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            // ,-----------------------------------------.             ,-----------------------------------------.
            // | ESC  |  1   |  2   |  3   |  4   |  5   |             |  6   |  7   |  8   |  9   |  0   |  `   |
            // | TAB  |  Q   |  W   |  E   |  R   |  T   |             |  Y   |  U   |  I   |  O   |  P   |  -   |
            // | CTRL |  A   |  S   |  D   |  F   |  G   | [         ] |  H   |  J   |  K   |  L   |  ;   |  '   |
            // | SHFT |  Z   |  X   |  C   |  V   |  B   |             |  N   |  M   |  ,   |  .   |  /   | SHFT |
            // `-------------| GUI  | ALT  | SPC  |LOWER |             |RAISE | ENT  | BSPC | ALT  | GUI  |------'
            // (thumbs: super inny middy reachy | reachy middy inny super; [ ] = thumb_extra)
            bindings = <
&kp ESC   &kp N1 &kp N2 &kp N3 &kp N4 &kp N5      &kp N6 &kp N7 &kp N8    &kp N9  &kp N0   &kp GRAVE
&kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T       &kp Y  &kp U  &kp I     &kp O   &kp P    &kp MINUS
&kp LCTRL &kp A  &kp S  &kp D  &kp F  &kp G       &kp H  &kp J  &kp K     &kp L   &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X  &kp C  &kp V  &kp B       &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
     &kp LGUI &kp LALT &kp SPACE &mo LOWER &kp LBKT    &kp RBKT &mo RAISE &kp RET &kp BSPC &kp RALT
            >;
        };

        lower_layer {
            display-name = "Lower";
            // Function keys and symbols.
            // |  F1  |  F2  |  F3  |  F4  |  F5  |  F6  |             |  F7  |  F8  |  F9  | F10  | F11  | F12  |
            // |  `   |  !   |  @   |  #   |  $   |  %   |             |  ^   |  &   |  *   |  (   |  )   |  ~   |
            // |      |      |      |      |      |      | {         } |  -   |  =   |  [   |  ]   |  \   |  |   |
            // |      |      |      |      |      |      |             |  _   |  +   |  {   |  }   |      |      |
            bindings = <
&kp F1    &kp F2   &kp F3 &kp F4   &kp F5   &kp F6       &kp F7    &kp F8    &kp F9    &kp F10  &kp F11  &kp F12
&kp GRAVE &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT    &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp TILDE
&trans    &trans   &trans &trans   &trans   &trans       &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &kp PIPE
&trans    &trans   &trans &trans   &trans   &trans       &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &trans   &trans
     &trans &trans &trans &trans &kp LBRC                &kp RBRC &trans &trans &kp DEL &trans
            >;
        };

        raise_layer {
            display-name = "Raise";
            // Navigation and media.
            // |      |      |      |      |      |      |             |      |      |      |      |      |      |
            // |      |      |      |      |      |      |             | PGUP | HOME |  UP  | END  | INS  | DEL  |
            // |      | PREV | PLAY | NEXT | VOL- | VOL+ |             | PGDN | LEFT | DOWN |RIGHT |      |      |
            // |      |      |      |      | MUTE |      |             |      |      |      |      |      |      |
            bindings = <
&trans &trans      &trans     &trans      &trans         &trans          &trans     &trans    &trans    &trans    &trans  &trans
&trans &trans      &trans     &trans      &trans         &trans          &kp PG_UP  &kp HOME  &kp UP    &kp END   &kp INS &kp DEL
&trans &kp C_PREV  &kp C_PP   &kp C_NEXT  &kp C_VOL_DN   &kp C_VOL_UP    &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT &trans  &trans
&trans &trans      &trans     &trans      &kp C_MUTE     &trans          &trans     &trans    &trans    &trans    &trans  &trans
     &trans &trans &trans &trans &trans                  &trans &trans &trans &trans &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            // Bluetooth, output and firmware keys (hold LOWER + RAISE).
            // BT0-BT4: pick a paired device. BTCLR: forget the current one.
            // USB/BLE: send keys over the cable or Bluetooth.
            // BOOT: flashing mode, RESET: restart. They act on the half you press them on.
            // | BT0  | BT1  | BT2  | BT3  | BT4  |BTCLR |             |      |      |      |      |      |      |
            // | USB  | BLE  |      |      |      |      |             |      |      |      |      |      |      |
            // |      |      |      |      |      |      |             |      |      |      |      |      |      |
            // | BOOT |RESET |      |      |      |      |             |      |      |      |      |RESET | BOOT |
            bindings = <
&bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_CLR    &none &none &none &none &none      &none
&out OUT_USB &out OUT_BLE &none        &none        &none        &none         &none &none &none &none &none      &none
&none        &none        &none        &none        &none        &none         &none &none &none &none &none      &none
&bootloader  &sys_reset   &none        &none        &none        &none         &none &none &none &none &sys_reset &bootloader
     &trans &trans &trans &trans &none                           &none &trans &trans &trans &trans
            >;
        };
    };
};
