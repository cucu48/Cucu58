/*
 * Cucu58: the part of the hardware description shared by both halves.
 *
 * Matrix (per half): 6 columns x 5 rows, COL2ROW diodes (see README.md > Wiring).
 *   rows (kscan order): 0 num, 1 top, 2 home, 3 bottom, 4 thumb
 *   left columns:  0 outer, 1 pinky, 2 ring, 3 middle, 4 index, 5 inner
 *   right columns: 0 inner, 1 index, 2 middle, 3 ring, 4 pinky, 5 outer (listed in
 *                  physical order, left to right, so the transform is a simple offset)
 * The GPIO pins differ per half (the right PCB is flipped), so they live in the overlays.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include "cucu58-layout.dtsi"

&cucu58_layout {
    transform = <&default_transform>;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &cucu58_layout;
    };

    /*
     * Maps every (row, column) of the electrical matrix to a position in the keymap.
     * Both halves together form a 12-column matrix: the right half is shifted by 6
     * columns (col-offset in cucu58_right.overlay).
     *
     *  num    | outer pinky ring middle index inner |   | inner index middle ring pinky outer |
     *  top    |  ...                                |   |  ...                                |
     *  home   |  ...                                |   |  ...                                |
     *  bottom |  ...                                |   |  ...                                |
     *  thumb  |      super inny middy reachy extra  |   | extra reachy middy inny super       |
     *
     * The outer column has no thumb key, so RC(4,0) and RC(4,11) are not used.
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)   RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)   RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)   RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)   RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
        RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)   RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        // Lets a key press wake the board from deep sleep (CONFIG_ZMK_SLEEP).
        wakeup-source;
        // Current flows column -> switch -> diode -> row (diode cathode on the row net).
        diode-direction = "col2row";
        // col-gpios and row-gpios: see cucu58_left.overlay / cucu58_right.overlay
    };
};
